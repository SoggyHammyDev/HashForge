<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <!--
      Tells the garbage collector to favour a small footprint (0 is off, 9 is the most frugal). In a load test
      with 10,000 miners this cut memory under load by roughly a fifth with no extra time spent paused, where
      the alternative of the workstation collector saved about the same but paused three times as long.
    -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HashForge.Stratum\HashForge.Stratum.csproj" />
    <ProjectReference Include="..\HashForge.Persistence\HashForge.Persistence.csproj" />
  </ItemGroup>
</Project>
