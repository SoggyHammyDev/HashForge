@page "/admin/node-setup"
@inject IConfiguration Configuration
@inject IAdminAccessPolicy AdminAccess

<BrandTitle Page="Node setup" />
<div class="page-head">
    <h1>Bitcoin node setup</h1>
    <p>Choose how to initialize the dedicated Bitcoin node before it starts.</p>
</div>
@if (!AdminAccess.IsAllowed(HttpContext?.Connection.RemoteIpAddress))
{
    <p class="notice">Setup is unavailable from this network.</p>
}
else if (Configuration["NodeSetup:Enabled"] != "true")
{
    <p class="notice">Managed setup is not enabled for this installation.</p>
}
else if (WorkerEnabled && System.IO.File.Exists("/requests/request"))
{
    <p class="notice">Setup request submitted. Refresh this page for the latest worker status.</p>
    <p>@WorkerStatus()</p>
}
else if (System.IO.File.Exists("/setup/decision"))
{
    <p class="notice">A setup decision already exists. Open the Bitcoin Node page to monitor synchronization.</p>
}
else
{
    <SectionCard Icon="IconKind.Sync" Title="Start a fresh archival sync">
        <p>This starts downloading and validating Bitcoin into HashForge's independent storage. It does not access another application's blockchain.</p>
        <EditForm Model="Form!" FormName="node-setup" OnValidSubmit="ApproveFresh" class="stack-form">
            <label>Setup authorization code <InputText type="password" @bind-Value="Form!.Token" autocomplete="off" /></label>
            <label><InputCheckbox @bind-Value="Form!.Confirmed" /> I have checked available storage and confirmed my setup choice.</label>
            @if (WorkerEnabled)
            {
                <label>Setup method
                    <InputSelect @bind-Value="Form!.Mode">
                        <option value="fresh">Fresh synchronization</option>
                        <option value="imported">Import the host-prepared snapshot</option>
                    </InputSelect>
                </label>
                <p>For imports, confirm the host administrator prepared a clean, compatible archival snapshot and sufficient space.</p>
            }
            <button type="submit">Submit setup choice</button>
        </EditForm>
        @if (_message is not null)
        {
            <p role="status">@_message</p>
        }
    </SectionCard>
    <SectionCard Icon="IconKind.Storage" Title="Import an existing blockchain">
        <p>Do not start a fresh sync if you intend to import. Ask the host administrator to prepare a compatible, clean, read-only snapshot and run the offline importer. The original node's data remains independent.</p>
        <p>After verification the administrator publishes the imported setup decision. When the restricted worker is enabled, select import above to request copying the single host-prepared snapshot.</p>
    </SectionCard>
}
<p><a href="node">View Bitcoin node status</a></p>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    [SupplyParameterFromForm]
    private SetupForm? Form { get; set; }

    protected override void OnInitialized() => Form ??= new();

    private string? _message;
    private bool WorkerEnabled => Configuration["NodeSetup:WorkerEnabled"] == "true";

    private static string WorkerStatus()
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(System.IO.File.ReadAllText("/status/state.json"));
            var root = document.RootElement;
            var phase = root.GetProperty("phase").GetString();
            return root.TryGetProperty("percent", out var percent) ? $"{phase}: {percent.GetDouble():F2}% verified" : phase ?? "Waiting for worker";
        }
        catch (IOException) { return "Waiting for worker"; }
        catch (UnauthorizedAccessException) { return "Worker status unavailable"; }
        catch (System.Text.Json.JsonException) { return "Worker status unavailable"; }
    }

    private void ApproveFresh()
    {
        var expected = Configuration["NodeSetup:Token"];
        if (!AdminAccess.IsAllowed(HttpContext?.Connection.RemoteIpAddress) ||
            Configuration["NodeSetup:Enabled"] != "true" ||
            Form is null || !Form.Confirmed || string.IsNullOrWhiteSpace(expected) || expected.Length < 32 ||
            !System.Security.Cryptography.CryptographicOperations.FixedTimeEquals(
                System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(expected)),
                System.Security.Cryptography.SHA256.HashData(System.Text.Encoding.UTF8.GetBytes(Form.Token ?? ""))))
        {
            _message = "Setup authorization or confirmation failed.";
            return;
        }

        // Fixed directory and fixed decision only. Never accept a path or shell command from the browser.
        var mode = WorkerEnabled ? Form.Mode : "fresh";
        if (mode is not ("fresh" or "imported"))
        {
            _message = "Invalid setup choice.";
            return;
        }
        var directory = WorkerEnabled ? "/requests" : "/setup";
        var target = System.IO.Path.Combine(directory, WorkerEnabled ? "request" : "decision");
        var temp = System.IO.Path.Combine(directory, ".decision-" + Guid.NewGuid().ToString("N"));
        try
        {
            System.IO.File.WriteAllText(temp, mode + "\n");
            System.IO.File.Move(temp, target, overwrite: false);
            _message = WorkerEnabled ? "Setup request submitted." : "Fresh synchronization approved.";
        }
        catch (IOException)
        {
            _message = "Setup could not be saved or has already been approved.";
        }
        catch (UnauthorizedAccessException)
        {
            _message = "Setup storage is not writable.";
        }
        finally
        {
            if (System.IO.File.Exists(temp))
            {
                System.IO.File.Delete(temp);
            }
        }
    }

    private sealed class SetupForm
    {
        public string? Token { get; set; }
        public bool Confirmed { get; set; }
        public string Mode { get; set; } = "fresh";
    }
}
