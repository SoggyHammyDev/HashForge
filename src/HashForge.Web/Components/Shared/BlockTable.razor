@if (Blocks.Count == 0)
{
    <p class="empty">No blocks found yet.</p>
}
else
{
    <div class="table-scroll">
        <table>
            <thead>
                <tr>
                    <th>Height</th>
                    @if (ShowPool)
                    {
                        <th>Pool</th>
                    }
                    <th>Found by</th>
                    <th class="num">Effort</th>
                    <th class="num">Reward</th>
                    <th class="num">Miners paid</th>
                    <th>Found</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var block in Blocks)
                {
                    <tr>
                        <td class="mono"><a href="block/@block.Hash" title="@block.Hash">@block.Height</a></td>
                        @if (ShowPool)
                        {
                            <td><a href="pool/@block.PoolName">@block.PoolName</a></td>
                        }
                        <td class="mono">@Display.Shorten(block.Worker.FullName)</td>
                        <td class="num">@Display.Percent(block.EffortPercent)</td>
                        <td class="num">@Display.Bitcoin(block.RewardSatoshis)</td>
                        <td class="num">@block.MinersPaid</td>
                        <td>@Display.Age(block.FoundAt, Now)</td>
                        <td><BlockStatusPill Block="block" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<FoundBlock> Blocks { get; set; } = [];

    [Parameter, EditorRequired]
    public DateTimeOffset Now { get; set; }

    /// <summary>Set to false where every block is from the same pool, so the column would only repeat itself.</summary>
    [Parameter]
    public bool ShowPool { get; set; } = true;
}
