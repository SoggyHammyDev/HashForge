@* A coloured dot with a label. The label always states the status, so colour is never the only signal. *@
<span class="pill pill-@Kind.ToString().ToLowerInvariant()">@Text</span>

@code {
    [Parameter, EditorRequired]
    public StatusKind Kind { get; set; }

    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;
}
